# ============================================================
# 复制本文件为 .env 后填入真实值
# ============================================================

# ---------- 大模型（OpenAI 兼容接口，支持多供应商自动回退）----------
# 优先级顺序：靠前的不可用时，自动回退到后面的
LLM_PROVIDER_ORDER=modelscope,dashscope

# ModelScope 魔搭（首选）
MODELSCOPE_API_KEY=ms-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# 阿里云百炼 DashScope（备用）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120
# 推理模型的思考过程也计入 token；实测 2048 会把正文挤空，这里给到 8192
LLM_MAX_TOKENS=8192

# ---------- MoneyPrinterTurbo 视频引擎 ----------
MPT_SKILL_DIR=D:/workspace/mpt-skill
MPT_ROOT=D:/workspace/MoneyPrinterTurbo
MPT_VIDEO_SOURCE=coverr
MPT_COVERR_API_KEY=your-coverr-api-key
MPT_TASK_TIMEOUT=3600
# PyPI 镜像（国内建议保留，直连 pypi.org 会非常慢）
MPT_PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
# 素材检索关键词（英文短词，逗号分隔；长短语在 Coverr 上搜不到结果）
MPT_VIDEO_TERMS=education,study,homework,student,learning,writing
MPT_VIDEO_ASPECT=9:16
MPT_VIDEO_LANGUAGE=zh-CN
